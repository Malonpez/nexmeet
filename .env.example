# Server
NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
BROKER52_ALLOWED_ORIGINS=http://localhost:8787

# LiveKit
# Use HTTPS for backend/project host and WSS for browser connection where required.
LIVEKIT_HOST=https://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=replace_me

# Future platform URLs
BROKER52_APP_URL=https://app.broker52.com
NEXMEET_PUBLIC_URL=https://meet.broker52.com
BROKER52_API_URL=https://api.broker52.com
